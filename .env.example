# Database — Neon Postgres (required for real data; omit for in-memory demo mode)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT signing secret — MUST be set to a long random value in production (never commit real secrets)
JWT_SECRET=

# Public app URL — used to build password-reset links (must be set in production;
# the reset link host is never taken from the request Host header there)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AgentMail — transactional email (password reset). Without these the reset flow
# still issues tokens and logs the link server-side, but sends no email.
AGENTMAIL_API_KEY=
AGENTMAIL_SYSTEM_INBOX_ID=

# Demo mode — set to false when wiring real data (shows empty states for new tenants)
NEXT_PUBLIC_USE_DEMO_DATA=true

# AI Gateway — at least one required for real generation
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: search-enriched generation (not yet used)
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
